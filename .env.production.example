# Copy to .env on your DigitalOcean VPS: cp .env.production.example .env

# ── Application Configuration 
NODE_ENV=production
PORT=3000
APP_NAME=Aegis-IAM
# Replace with your actual domain (must match what is configured in Nginx & DNS)
APP_URL=https://aegis.swatantracodes.in

# ── PostgreSQL Database 
# IMPORTANT: Use a strong, generated password in production!
DB_HOST=postgres
DB_PORT=5432
DB_NAME=iam_portal
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_HERE

# Redis Cache & Token Store 
REDIS_URL=redis://redis:6379

# Cryptographic Secrets (Argon2id, JWT, MFA) 
# Generate with: openssl rand -base64 48
# MUST be at least 32 characters long
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_JWT_SECRET_KEY_HERE
JWT_REFRESH_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_REFRESH_SECRET_KEY_HERE
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MFA TOTP AES-256-GCM Encryption Key 
# Generate with: openssl rand -hex 32
# MUST be at least 32 characters long
MFA_ENCRYPTION_KEY=REPLACE_WITH_MINIMUM_32_CHAR_HEX_ENCRYPTION_KEY

# Rate Limiting 
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
