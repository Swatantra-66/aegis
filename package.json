{
  "name": "iam-portal",
  "version": "1.0.0",
  "description": "Production-grade Identity & Access Management Portal with OAuth 2.0, JWT, RBAC, MFA, and audit logging",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "prepare": "husky",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seeds/run.js"
  },
  "keywords": [
    "iam",
    "authentication",
    "authorization",
    "rbac",
    "mfa",
    "oauth2",
    "jwt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/db/migrations/",
      "/src/db/seeds/"
    ],
    "verbose": true
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.4.1",
    "pg": "^8.23.0",
    "rate-limit-redis": "^6.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
