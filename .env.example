# The server WILL NOT START if required variables are missing.

# Application
NODE_ENV=development
PORT=3000
APP_NAME=IAM-Portal
APP_URL=http://localhost:3000

# PostgreSQL 
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iam_portal
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration
# Generate with OpenSSL: openssl rand -hex 32
# Generate with Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Must be at least 32 characters
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MFA Encryption
# Generate with OpenSSL: openssl rand -hex 32
# Generate with Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Must be at least 32 characters (used to encrypt TOTP secrets at rest via AES-256-GCM)
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-at-least-32-chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging 
LOG_LEVEL=debug
